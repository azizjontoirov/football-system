        "type": "object",
        "title": "HTTPValidationError"
      },
      "MatchCreateSchema": {
        "properties": {
          "tournament_id": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Tournament Id",
            "description": "Turnir ID raqami"
          },
          "home_team_id": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Home Team Id",
            "description": "Mezbon jamoa ID raqami"
          },
          "away_team_id": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Away Team Id",
            "description": "Mehmon jamoa ID raqami"
