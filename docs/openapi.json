        "title": "MatchCreateSchema",
        "example": {
          "away_team_id": 2,
          "home_team_id": 1,
          "tournament_id": 1
        }
      },
      "MatchResponseSchema": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "tournament_id": {
            "type": "integer",
            "title": "Tournament Id"
          },
          "home_team_id": {
            "type": "integer",
            "title": "Home Team Id"
          },
          "away_team_id": {
            "type": "integer",
            "title": "Away Team Id"
          },
          "home_score": {
            "type": "integer",
            "title": "Home Score"
          },
          "away_score": {
            "type": "integer",
            "title": "Away Score"
          },
          "status": {
            "type": "string",
            "title": "Status",
            "description": "Uchrashuv holati: scheduled yoki finished"
          }
        },
        "type": "object",
        "required": [
          "id",
          "tournament_id",
          "home_team_id",
          "away_team_id",
          "home_score",
          "away_score",
          "status"
        ],
        "title": "MatchResponseSchema",
        "example": {
          "away_score": 1,
          "away_team_id": 2,
          "home_score": 3,
          "home_team_id": 1,
          "id": 1,
          "status": "finished",
          "tournament_id": 1
        }
      },
      "MatchResultSchema": {
        "properties": {
          "home_score": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Home Score",
            "description": "Mezbon jamoa urgan gollar soni"
          },
          "away_score": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Away Score",
            "description": "Mehmon jamoa urgan gollar soni"
          }
        },
        "type": "object",
        "required": [
          "home_score",
          "away_score"
        ],
        "title": "MatchResultSchema",
        "example": {
          "away_score": 1,
          "home_score": 3
        }
      },
      "PlayerCreateSchema": {
        "properties": {
          "full_name": {
            "type": "string",
            "maxLength": 120,
            "minLength": 2,
            "title": "Full Name",
            "description": "O'yinchining ism-familiyasi"
          },
          "team_id": {
            "type": "integer",
